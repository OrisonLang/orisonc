package fixtures.dynamicarrayownedparameterswitchcleanupreuserejected

record Payload
    public value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function choose(flag: Bool, items: DynamicArray<Payload>) -> UInt32
    switch flag
        true =>
            use_items(items)
        false =>
            0 as UInt32

function main() -> IntSize
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    let result: UInt32 = choose(true, items)
    items.length()
