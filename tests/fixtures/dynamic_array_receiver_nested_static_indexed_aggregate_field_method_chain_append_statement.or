package fixtures.dynamicarray.receivernestedstaticindexedaggregatefieldmethodchainappendstatement

record Nested
    value: UInt32

record Payload
    child: Nested

record Bucket
    values: DynamicArray<Payload>

record GridHolder
    grid: Array<Array<Bucket, 2>, 2>

extend DynamicArray<T>
    function forward(this: exclusive This) -> DynamicArray<T>
        this

    function append_value(this: exclusive This, value: T) -> Unit
        this.push(value)

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(seed)))
    values

function make_grid() -> GridHolder
    GridHolder([[Bucket(make_values(7 as UInt32)), Bucket(make_values(11 as UInt32))], [Bucket(make_values(13 as UInt32)), Bucket(make_values(17 as UInt32))]])

function main() -> UInt32
    make_grid().grid[1][0].values.forward().append_value(Payload(Nested(19 as UInt32)))
    0 as UInt32
