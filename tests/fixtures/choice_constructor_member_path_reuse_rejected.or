package tests.fixtures.choice_constructor_member_path_reuse_rejected

record Payload
    value: UInt32

record Holder
    values: DynamicArray<Payload>

choice MaybeItems
    Empty
    Some(values: DynamicArray<Payload>)

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function main() -> UInt32
    var values: DynamicArray<Payload> = make_values(1 as UInt32)
    var holder: Holder = Holder(values)
    var selected: MaybeItems = Some(holder.values)
    var moved_again: MaybeItems = Some(holder.values)
    0 as UInt32
