package fixtures.dynamicarrayforwardedparameterfinalifownedcomputedforcleanuprun

record Payload
    value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function forward_items(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    items

function forward_final_if(flag: Bool, items: DynamicArray<Payload>) -> DynamicArray<Payload>
    if flag
        items
    else
        forward_items(items)

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    items.push(Payload(13))
    items.push(Payload(17))
    for item in true ? forward_final_if(true, items) : forward_final_if(false, items)
        total = total + item.value
    0 as UInt32
