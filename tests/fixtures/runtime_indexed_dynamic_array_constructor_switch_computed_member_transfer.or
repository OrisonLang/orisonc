package tests.fixtures.runtime_indexed_dynamic_array_constructor_switch_computed_member_transfer

record Inner
    value: UInt32

record Box
    item: Inner

record Outer
    item: Inner

function main() -> UInt32
    var items: DynamicArray<Box> = DynamicArray()
    items.push(Box(Inner(7 as UInt32)))
    items.push(Box(Inner(11 as UInt32)))
    var outer: Outer = Outer(items[choose_index(1 as UInt32)].item)
    0 as UInt32

function choose_index(selector: UInt32) -> UInt64
    switch selector
        0 as UInt32 => 0 as UInt64
        1 as UInt32 => 1 as UInt64
        default => 0 as UInt64
