package fixtures.dynamicarray.ownedprojectionrejected

record Nested
    value: UInt32

record Payload
    child: Nested

function main() -> UInt32
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(7 as UInt32)))
    let child: Nested = values[0].child
    child.value
