package tests.fixtures.dynamic_array_static_indexed_aggregate_owned_nested_computed_for_cleanup_run

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Bucket
    values: DynamicArray<Payload>

record Holder
    buckets: Array<Bucket, 2>

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function main() -> UInt32
    var holder: Holder = Holder([Bucket(make_values(40 as UInt32)), Bucket(make_values(80 as UInt32))])
    var total = 0 as UInt32
    for item in true ? holder.buckets[0].values : false ? holder.buckets[0 as UInt64].values : holder.buckets[0].values
        total = total + item.value
    total - 81 as UInt32
