package tests.fixtures.dynamic_array_owned_nested_field_scope_cleanup_run

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Inner
    values: DynamicArray<Payload>

record Outer
    inner: Inner

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(55 as UInt32))
    values.push(Payload(89 as UInt32))
    values

function main() -> UInt32
    var outer: Outer = Outer(Inner(make_values()))
    0 as UInt32
