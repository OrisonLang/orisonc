package fixtures.dynamicarray.receiverdirectownedcount

record Nested
    value: UInt32

record Payload
    child: Nested

extend DynamicArray<T>
    function count(this: shared This) -> IntSize
        this.length()

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(7 as UInt32)))
    values

function main() -> UInt32
    make_values().count() == 1 as IntSize ? 0 as UInt32 : 1 as UInt32
