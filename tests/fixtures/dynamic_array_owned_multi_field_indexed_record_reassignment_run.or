package tests.fixtures.dynamic_array_owned_multi_field_indexed_record_reassignment_run

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Item
    values: DynamicArray<Payload>
    spare: DynamicArray<Payload>

record Holder
    items: Array<Item, 2>

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_item(seed: UInt32) -> Item
    Item(make_values(seed), make_values(seed + 10 as UInt32))

function main() -> UInt32
    var holder: Holder = Holder([make_item(1 as UInt32), make_item(20 as UInt32)])
    holder.items = [make_item(40 as UInt32), make_item(60 as UInt32)]
    0 as UInt32
