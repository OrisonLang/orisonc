package fixtures.dynamicarray.receivernameddynamicarrayelementfieldmethodchaincountrun

record Nested
    value: UInt32

record Payload
    child: Nested

record Bucket
    values: DynamicArray<Payload>

record Holder
    items: DynamicArray<Bucket>

extend DynamicArray<T>
    function forward(this: exclusive This) -> DynamicArray<T>
        this

    function count(this: shared This) -> IntSize
        this.length()

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(seed)))
    values

function make_items() -> DynamicArray<Bucket>
    var items: DynamicArray<Bucket> = DynamicArray()
    items.push(Bucket(make_values(7 as UInt32)))
    items.push(Bucket(make_values(11 as UInt32)))
    items

function make_holder() -> Holder
    Holder(make_items())

function main() -> UInt32
    var holder: Holder = make_holder()
    let index: UInt64 = 0 as UInt64
    holder.items[index].values.forward().count() == 1 as IntSize ? 0 as UInt32 : 1 as UInt32
