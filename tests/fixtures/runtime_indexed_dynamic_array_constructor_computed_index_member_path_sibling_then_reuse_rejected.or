package tests.fixtures.runtime_indexed_dynamic_array_constructor_computed_index_member_path_sibling_then_reuse_rejected

record Inner
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Inner
    function drop(this: exclusive This) -> Unit
        return

record Outer
    item: Inner

implements Drop for Outer
    function drop(this: exclusive This) -> Unit
        return

function main() -> UInt32
    var items: DynamicArray<Inner> = DynamicArray()
    items.push(Inner(7 as UInt32))
    items.push(Inner(11 as UInt32))
    let index: UInt64 = 0 as UInt64
    var outer: Outer = Outer(items[index])
    let sibling: UInt32 = items[1].value
    items[index].value
