package fixtures.dynamicarray.receiverlocalcallresultcount

extend DynamicArray<T>
    function count(this: shared This) -> IntSize
        this.length()

function make_values() -> DynamicArray<UInt32>
    var values: DynamicArray<UInt32> = DynamicArray()
    values.push(7 as UInt32)
    values

function main() -> UInt32
    let values = make_values()
    values.count() == 1 as IntSize ? 0 as UInt32 : 1 as UInt32
