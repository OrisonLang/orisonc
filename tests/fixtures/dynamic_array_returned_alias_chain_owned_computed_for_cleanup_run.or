package fixtures.dynamicarrayreturnedaliaschainownedcomputedforcleanuprun

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(19 as UInt32))
    values.push(Payload(23 as UInt32))
    var alias: DynamicArray<Payload> = values
    var second_alias: DynamicArray<Payload> = alias
    second_alias

function main() -> UInt32
    var returned: DynamicArray<Payload> = make_values()
    var total: UInt32 = 0 as UInt32
    for item in true ? returned : returned
        total = total + item.value
    total == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
