package fixtures.dynamicarrayforwardedparameterfinalifaliasreassignedownedcomputedrejected

record Payload
    value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function forward_final_if_alias_reassigned(flag: Bool, items: DynamicArray<Payload>) -> DynamicArray<Payload>
    if flag
        var alias: DynamicArray<Payload> = items
        alias = items
        alias
    else
        var alias: DynamicArray<Payload> = items
        alias

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    items.push(Payload(13))
    items.push(Payload(17))
    for item in true ? forward_final_if_alias_reassigned(true, items) : forward_final_if_alias_reassigned(false, items)
        total = total + item.value
    0 as UInt32
