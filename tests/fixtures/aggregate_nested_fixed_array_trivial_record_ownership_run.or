package fixtures.aggregatenestedfixedarraytrivialrecordownershiprun

record Payload
    public value: UInt32

record Bucket
    public items: Array<Payload, 2>

record Holder
    public buckets: Array<Bucket, 2>

function consume_payload(payload: Payload) -> UInt32
    payload.value

function choose_if(flag: Bool) -> UInt32
    let holder: Holder = Holder([Bucket([Payload(3 as UInt32), Payload(5 as UInt32)]), Bucket([Payload(7 as UInt32), Payload(11 as UInt32)])])
    if flag
        consume_payload(holder.buckets[1].items[0])
    else
        0 as UInt32

function choose_switch(flag: Bool) -> UInt32
    let holder: Holder = Holder([Bucket([Payload(13 as UInt32), Payload(17 as UInt32)]), Bucket([Payload(19 as UInt32), Payload(23 as UInt32)])])
    switch flag
        true => consume_payload(holder.buckets[0].items[1])
        false => 0 as UInt32

function consume_distinct() -> UInt32
    let holder: Holder = Holder([Bucket([Payload(29 as UInt32), Payload(31 as UInt32)]), Bucket([Payload(37 as UInt32), Payload(41 as UInt32)])])
    let first: UInt32 = consume_payload(holder.buckets[0].items[0])
    first + consume_payload(holder.buckets[0].items[1])

function main() -> UInt32
    let if_consumed: UInt32 = choose_if(true)
    let if_finalized: UInt32 = choose_if(false)
    let switch_consumed: UInt32 = choose_switch(true)
    let switch_finalized: UInt32 = choose_switch(false)
    let distinct: UInt32 = consume_distinct()
    if_consumed - 7 as UInt32 + if_finalized + switch_consumed - 17 as UInt32 + switch_finalized + distinct - 60 as UInt32
