package fixtures.dynamicarrayforwardedparametercycleownedcomputedrejected

record Payload
    value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function forward_cycle_left(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    forward_cycle_right(items)

function forward_cycle_right(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    forward_cycle_left(items)

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    items.push(Payload(13))
    items.push(Payload(17))
    for item in true ? forward_cycle_left(items) : forward_cycle_left(items)
        total = total + item.value
    0 as UInt32
