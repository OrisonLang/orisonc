package fixtures.dynamicarrayownednestedaggregateparameterfieldcleanupreuserejected

record Payload
    public value: Int64

record Inner
    public items: DynamicArray<Payload>

record Holder
    public inner: Inner

function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function consume(holder: Holder) -> IntSize
    use_items(holder.inner.items)
    use_items(holder.inner.items)
    0 as IntSize

function main() -> IntSize
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    consume(Holder(Inner(items)))
