choice Taken
    Empty
    Some(values: DynamicArray<UInt32>)

async function main() -> UInt32
    var values: DynamicArray<UInt32> = DynamicArray()
    var holder: Holder = Holder(values)
    var moved: Taken = Some(holder.values)
    let pending = task
        47 as UInt32

    holder.values.push(await pending)
    0 as UInt32
