package tests.fixtures.generic_switch_payload_alias_run

record Box<T>
    value: T

record Envelope<T>
    inner: Box<T>

choice Index
    Value(index: UInt64)
    Empty

extend UInt64
    function choose<T>(this: shared This, candidate: T) -> T
        candidate

extend Box<T>
    function value_copy(this: shared This) -> T
        this.value

function identity<T>(value: T) -> T
    value

function select(index: Index) -> UInt64
    switch index
        Value(value) =>
            let payload_box = Box(value)
            let chosen: UInt64 = value.choose(value)
            let boxed = Box(chosen)
            let copied = boxed.value_copy()
            let specialized = identity(copied)
            let envelope = Envelope(Box(specialized))
            envelope.inner.value
        Empty => 0 as UInt64

function main() -> UInt32
    select(Value(7 as UInt64)) == 7 as UInt64 and select(Empty) == 0 as UInt64 ? 0 as UInt32 : 1 as UInt32
