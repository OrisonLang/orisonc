package tests.fixtures.dynamic_array_runtime_index_boolean_nested_and_or_member_path_condition_for_run

record Payload
    value: UInt32

record Bucket
    values: DynamicArray<Payload>

record Holder
    buckets: Array<Bucket, 2>

record IndexConfig
    enabled: Bool

record IndexSettings
    groups: Array<IndexConfig, 2>

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values

function make_holder(seed: UInt32) -> Holder
    Holder([Bucket(make_values(seed)), Bucket(make_values(seed + 20 as UInt32))])

function sum_selected(root_flag: Bool, gate: Bool, fallback: Bool, group_slot: UInt64, first: UInt64, second: UInt64) -> UInt32
    var left: Holder = make_holder(40 as UInt32)
    var right: Holder = make_holder(80 as UInt32)
    var settings = IndexSettings([IndexConfig(true), IndexConfig(false)])
    var total = 0 as UInt32
    for item in root_flag ? left.buckets[gate and (fallback or settings.groups[group_slot].enabled) ? first : second].values : right.buckets[gate and (fallback or settings.groups[group_slot].enabled) ? first : second].values
        total = total + item.value
    total

function main() -> UInt32
    sum_selected(true, false, false, 2 as UInt64, 0 as UInt64, 1 as UInt64) + sum_selected(false, false, false, 2 as UInt64, 0 as UInt64, 1 as UInt64) + sum_selected(true, true, true, 2 as UInt64, 0 as UInt64, 1 as UInt64) + sum_selected(false, true, true, 2 as UInt64, 0 as UInt64, 1 as UInt64) + sum_selected(true, true, false, 0 as UInt64, 0 as UInt64, 1 as UInt64) + sum_selected(false, true, false, 1 as UInt64, 0 as UInt64, 1 as UInt64) - 420 as UInt32
