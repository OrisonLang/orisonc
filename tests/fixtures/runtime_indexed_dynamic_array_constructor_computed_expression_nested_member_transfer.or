package tests.fixtures.runtime_indexed_dynamic_array_constructor_computed_expression_nested_member_transfer

record Inner
    value: UInt32

record Box
    item: Inner

record Outer
    item: Inner

function main() -> UInt32
    var items: DynamicArray<Box> = DynamicArray()
    items.push(Box(Inner(7 as UInt32)))
    items.push(Box(Inner(11 as UInt32)))
    let index: UInt64 = 0 as UInt64
    let zero: UInt64 = 0 as UInt64
    var outer: Outer = Outer(items[index + zero].item)
    0 as UInt32
