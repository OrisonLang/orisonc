package fixtures.dynamicarray.receiverownedreadrejected

record Payload
    value: UInt32

extend DynamicArray<T>
    function first(this: shared This) -> T
        this[0]

function main() -> UInt32
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(7 as UInt32))
    let first: Payload = values.first()
    first.value
