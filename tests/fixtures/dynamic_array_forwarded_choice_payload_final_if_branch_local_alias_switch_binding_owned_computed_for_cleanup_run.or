package fixtures.dynamicarrayforwardedchoicepayloadfinalifbranchlocalaliasswitchbindingownedcomputedforcleanuprun

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

choice Packet
    Primary(values: DynamicArray<Payload>)

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(61 as UInt32))
    values.push(Payload(67 as UInt32))
    values

function forward_packet(packet: Packet) -> Packet
    packet

function forward_packet_final_if_alias(flag: Bool, packet: Packet) -> Packet
    if flag
        let selected: Packet = packet
        selected
    else
        var selected: Packet = forward_packet(packet)
        selected

function consume_packet(packet: Packet) -> UInt32
    var total = 0 as UInt32
    switch forward_packet_final_if_alias(false, packet)
        Primary(values) =>
            for item in true ? values : false ? values : values
                total = total + item.value
    total - 128 as UInt32

function main() -> UInt32
    consume_packet(Primary(make_values()))
