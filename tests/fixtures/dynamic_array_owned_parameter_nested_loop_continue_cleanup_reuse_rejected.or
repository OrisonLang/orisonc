package fixtures.dynamicarrayownedparameternestedloopcontinuecleanupreuserejected

record Payload
    public value: Int64

function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function consume(items: DynamicArray<Payload>) -> IntSize
    var outer = 0 as UInt64
    while outer < 1 as UInt64
        var inner = 0 as UInt64
        while inner < 1 as UInt64
            use_items(items)
            inner = inner + 1 as UInt64
            if inner == 1 as UInt64
                continue
        outer = outer + 1 as UInt64
    items.length()

function main() -> IntSize
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    consume(items)
