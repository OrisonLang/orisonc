package fixtures.dynamicarrayforwardedchoicepayloadnestedfinalifswitchbranchlocalaliasownermismatchrejected

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

choice Packet
    Primary(values: DynamicArray<Payload>)

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_packet(seed: UInt32) -> Packet
    Primary(make_values(seed))

function forward_packet(packet: Packet) -> Packet
    packet

function forward_packet_nested_alias(flag: Bool, left: Packet, right: Packet) -> Packet
    if flag
        let selected: Packet = left
        selected
    else
        switch flag
            true =>
                let selected: Packet = left
                selected
            false =>
                var selected: Packet = forward_packet(right)
                selected

function consume_packet(left: Packet, right: Packet) -> UInt32
    var total = 0 as UInt32
    switch forward_packet_nested_alias(false, left, right)
        Primary(values) =>
            for item in true ? values : false ? values : values
                total = total + item.value
    total

function main() -> UInt32
    consume_packet(make_packet(113 as UInt32), make_packet(127 as UInt32))
