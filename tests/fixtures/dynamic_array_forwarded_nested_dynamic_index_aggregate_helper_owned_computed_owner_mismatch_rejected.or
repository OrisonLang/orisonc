package fixtures.dynamicarrayforwardednesteddynamicindexaggregatehelperownedcomputedownermismatchrejected

record Payload
    value: UInt32

record Bucket
    values: DynamicArray<Payload>

record Holder
    grid: Array<Array<Bucket, 2>, 2>

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_holder() -> Holder
    Holder([[Bucket(make_values(10 as UInt32)), Bucket(make_values(20 as UInt32))], [Bucket(make_values(100 as UInt32)), Bucket(make_values(200 as UInt32))]])

function forward_holder(holder: Holder) -> Holder
    holder

function main() -> UInt32
    var holder: Holder = make_holder()
    var row = 1 as UInt64
    var column = 0 as UInt64
    var total = 0 as UInt32
    for item in true ? forward_holder(holder).grid[row][column].values : forward_holder(holder).grid[column][row].values
        total = total + item.value
    total
