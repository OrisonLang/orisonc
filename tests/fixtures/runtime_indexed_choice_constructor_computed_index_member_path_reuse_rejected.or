package tests.fixtures.runtime_indexed_choice_constructor_computed_index_member_path_reuse_rejected

record Inner
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Inner
    function drop(this: exclusive This) -> Unit
        return

record Holder
    items: Array<Inner, 2>

implements Drop for Holder
    function drop(this: exclusive This) -> Unit
        return

choice MaybeInner
    Empty
    Some(item: Inner)

function make_inner(seed: UInt32) -> Inner
    Inner(seed)

function main() -> UInt32
    var items: Array<Inner, 2> = [make_inner(1 as UInt32), make_inner(20 as UInt32)]
    var holder: Holder = Holder(items)
    let index: UInt64 = 0 as UInt64
    var selected: MaybeInner = Some(holder.items[index])
    holder.items[index].value
