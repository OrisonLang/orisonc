package fixtures.dynamicarrayforwardedparameterfinalswitchifownedcomputedownermismatchrejected

record Payload
    value: Int64

function forward_items(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    items

function forward_final_switch_if(selector: Bool, flag: Bool, left: DynamicArray<Payload>, right: DynamicArray<Payload>) -> DynamicArray<Payload>
    switch selector
        true =>
            left
        false =>
            if flag
                forward_items(right)
            else
                left

function main() -> UInt32
    var left: DynamicArray<Payload> = DynamicArray()
    var right: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    left.push(Payload(13))
    right.push(Payload(17))
    for item in true ? forward_final_switch_if(true, true, left, right) : forward_final_switch_if(false, false, left, right)
        total = total + item.value
    0 as UInt32
