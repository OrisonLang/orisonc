package tests.fixtures.dynamic_array_owned_field_scope_cleanup_run

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Holder
    values: DynamicArray<Payload>

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(21 as UInt32))
    values.push(Payload(34 as UInt32))
    values

function main() -> UInt32
    var holder: Holder = Holder(make_values())
    0 as UInt32
