package tests.fixtures.runtime_indexed_dynamic_array_constructor_branch_computed_member_transfer

record Inner
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Inner
    function drop(this: exclusive This) -> Unit
        return

record Box
    item: Inner

implements Drop for Box
    function drop(this: exclusive This) -> Unit
        return

record Outer
    item: Inner

implements Drop for Outer
    function drop(this: exclusive This) -> Unit
        return

function main() -> UInt32
    var items: DynamicArray<Box> = DynamicArray()
    items.push(Box(Inner(7 as UInt32)))
    items.push(Box(Inner(11 as UInt32)))
    var outer: Outer = Outer(items[choose_index(true)].item)
    0 as UInt32

function choose_index(left: Bool) -> UInt64
    if left
        0 as UInt64
    else
        1 as UInt64
