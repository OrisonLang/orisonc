package fixtures.dynamicarrayforwardedparameterfinalifswitchaliasreassignedownedcomputedrejected

record Payload
    value: Int64

function forward_final_if_switch_alias_reassigned(flag: Bool, selector: Bool, items: DynamicArray<Payload>) -> DynamicArray<Payload>
    if flag
        var alias: DynamicArray<Payload> = items
        alias = items
        alias
    else
        switch selector
            true =>
                var alias: DynamicArray<Payload> = items
                alias
            false =>
                var alias: DynamicArray<Payload> = items
                alias

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    items.push(Payload(13))
    items.push(Payload(17))
    for item in true ? forward_final_if_switch_alias_reassigned(true, true, items) : forward_final_if_switch_alias_reassigned(false, false, items)
        total = total + item.value
    0 as UInt32
