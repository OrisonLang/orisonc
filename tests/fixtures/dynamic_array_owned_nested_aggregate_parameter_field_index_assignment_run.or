package fixtures.dynamicarrayownednestedaggregateparameterfieldindexassignmentrun

record Payload
    public value: Int64

record Inner
    public items: DynamicArray<Payload>

record Holder
    public inner: Inner

function replace(holder: Holder) -> UInt32
    var current: Holder = holder
    current.inner.items[0] = Payload(8)
    0 as UInt32

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    replace(Holder(Inner(items)))
