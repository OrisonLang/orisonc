package fixtures.dynamicarraypushownedpayloadreuse

record Payload
    public value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function main() -> Int64
    var items: DynamicArray<Payload> = DynamicArray()
    let payload = Payload(7)
    items.push(payload)
    payload.value
