package fixtures.dynamicarray.receiverreturnedaggregatefieldmethodchaincount

record Nested
    value: UInt32

record Payload
    child: Nested

record PayloadBox
    values: DynamicArray<Payload>

extend DynamicArray<T>
    function forward(this: exclusive This) -> DynamicArray<T>
        this

    function count(this: shared This) -> IntSize
        this.length()

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(7 as UInt32)))
    values

function make_box() -> PayloadBox
    PayloadBox(make_values())

function main() -> UInt32
    make_box().values.forward().count() == 1 as IntSize ? 0 as UInt32 : 1 as UInt32
