package tests.fixtures.generic_loop_binding_alias_run

record Box<T>
    value: T

record Envelope<T>
    inner: Box<T>

extend UInt64
    function choose<T>(this: shared This, candidate: T) -> T
        candidate

extend Box<T>
    function value_copy(this: shared This) -> T
        this.value

function identity<T>(value: T) -> T
    value

function sum(values: Array<UInt64, 2>) -> UInt64
    var total = 0 as UInt64
    for value in values
        let chosen: UInt64 = value.choose(value)
        let boxed = Box(chosen)
        let copied = boxed.value_copy()
        let specialized = identity(copied)
        let envelope = Envelope(Box(specialized))
        total = total + envelope.inner.value
    total

function main() -> UInt32
    sum([7 as UInt64, 9 as UInt64]) == 16 as UInt64 ? 0 as UInt32 : 1 as UInt32
