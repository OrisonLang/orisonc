package tests.fixtures.dynamic_array_runtime_indexed_distinct_root_generic_record_constructor_index_for_run

record Payload
    value: UInt32

record Bucket
    values: DynamicArray<Payload>

record Holder
    buckets: Array<Bucket, 2>

record IndexValue<T>
    selected: T

record IndexEnvelope<T>
    inner: IndexValue<T>

record IndexConfig
    values: Array<UInt64, 1>

function normalize_index(value: UInt64) -> UInt64
    value

function identity<T>(value: T) -> T
    value

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values

function make_holder(seed: UInt32) -> Holder
    Holder([Bucket(make_values(seed)), Bucket(make_values(seed + 20 as UInt32))])

function sum_selected(root_flag: Bool, index: UInt64) -> UInt32
    var left: Holder = make_holder(40 as UInt32)
    var right: Holder = make_holder(80 as UInt32)
    let config: IndexConfig = IndexConfig([index])
    let selected = normalize_index(config.values[0])
    let generic_selected = identity(selected)
    var total = 0 as UInt32
    for item in root_flag ? left.buckets[IndexEnvelope(IndexValue(generic_selected)).inner.selected].values : right.buckets[IndexEnvelope(IndexValue(generic_selected)).inner.selected].values
        total = total + item.value
    total

function main() -> UInt32
    sum_selected(true, 0 as UInt64) + sum_selected(false, 1 as UInt64) - 140 as UInt32
