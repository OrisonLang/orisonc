function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function consume(holder: Holder) -> IntSize
    use_items(holder.items)
    use_items(holder.items)
    0 as IntSize

function main() -> IntSize
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    consume(Holder(items))
