package tests.fixtures.choice_dynamic_array_distinct_payload

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

choice Buffered
    Ready(values: DynamicArray<Payload>)
    Code(value: UInt32)
    Empty

function consume(buffer: Buffered) -> UInt32
    0 as UInt32

function consume_switch(buffer: Buffered) -> UInt32
    switch buffer
        Ready(values) => 1 as UInt32
        Code(value) => value
        Empty => 0 as UInt32

function make_buffer(values: DynamicArray<Payload>) -> Buffered
    Ready(values)
