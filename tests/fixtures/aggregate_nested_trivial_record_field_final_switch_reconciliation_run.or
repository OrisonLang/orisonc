package fixtures.aggregatenestedtrivialrecordfieldfinalswitchreconciliationrun

record Payload
    public value: UInt32

record Box
    public payload: Payload

record Nested
    public box: Box

function consume_payload(payload: Payload) -> UInt32
    payload.value

function choose(flag: Bool) -> UInt32
    let nested: Nested = Nested(Box(Payload(11 as UInt32)))
    switch flag
        true => consume_payload(nested.box.payload)
        false => 0 as UInt32

function main() -> UInt32
    let consumed_path: UInt32 = choose(true)
    let finalized_path: UInt32 = choose(false)
    consumed_path - 11 as UInt32 + finalized_path
