package fixtures.dynamicarrayforwardedparameterfinalswitchownedcomputedownermismatchrejected

record Payload
    value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function forward_items(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    items

function forward_final_switch(flag: Bool, left: DynamicArray<Payload>, right: DynamicArray<Payload>) -> DynamicArray<Payload>
    switch flag
        true =>
            left
        false =>
            forward_items(right)

function main() -> UInt32
    var left: DynamicArray<Payload> = DynamicArray()
    var right: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    left.push(Payload(13))
    right.push(Payload(17))
    for item in true ? forward_final_switch(true, left, right) : forward_final_switch(false, left, right)
        total = total + item.value
    0 as UInt32
