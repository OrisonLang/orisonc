package fixtures.dynamicarrayownedresulthelpercallcleanuprun

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function forward_values(values: DynamicArray<Payload>) -> DynamicArray<Payload>
    values

function choose(selector: UInt32, inner: Bool) -> DynamicArray<Payload>
    switch selector
        0 =>
            var first_values: DynamicArray<Payload> = make_values(7 as UInt32)
            var first_scratch: DynamicArray<Payload> = make_values(17 as UInt32)
            forward_values(first_values)
        1 =>
            if inner
                var left_values: DynamicArray<Payload> = make_values(19 as UInt32)
                var left_scratch: DynamicArray<Payload> = make_values(23 as UInt32)
                forward_values(left_values)
            else
                var right_values: DynamicArray<Payload> = make_values(29 as UInt32)
                var right_scratch: DynamicArray<Payload> = make_values(31 as UInt32)
                forward_values(right_values)
        default =>
            var third_values: DynamicArray<Payload> = make_values(37 as UInt32)
            var third_scratch: DynamicArray<Payload> = make_values(41 as UInt32)
            forward_values(third_values)

function consume_items(items: DynamicArray<Payload>) -> UInt32
    items.length() == 2 ? 0 as UInt32 : 1 as UInt32

function main() -> UInt32
    var selected: DynamicArray<Payload> = choose(1 as UInt32, false)
    consume_items(selected)
