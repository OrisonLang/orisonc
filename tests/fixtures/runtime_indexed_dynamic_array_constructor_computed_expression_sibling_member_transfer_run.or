package tests.fixtures.runtime_indexed_dynamic_array_constructor_computed_expression_sibling_member_transfer_run

record Inner
    value: UInt32

record Sibling
    value: UInt32

record Tail
    value: UInt32

record Box
    prefix: Sibling
    item: Inner
    tail: Tail

record Outer
    item: Inner

function main() -> UInt32
    var items: DynamicArray<Box> = DynamicArray()
    items.push(Box(Sibling(17 as UInt32), Inner(7 as UInt32), Tail(27 as UInt32)))
    items.push(Box(Sibling(19 as UInt32), Inner(11 as UInt32), Tail(29 as UInt32)))
    let index: UInt64 = 0 as UInt64
    let zero: UInt64 = 0 as UInt64
    var outer: Outer = Outer(items[index + zero].item)
    0 as UInt32
