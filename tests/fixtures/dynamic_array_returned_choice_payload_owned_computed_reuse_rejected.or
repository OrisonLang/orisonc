package fixtures.dynamicarrayreturnedchoicepayloadownedcomputedreuserejected

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

choice Packet
    Primary(values: DynamicArray<Payload>)

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(29 as UInt32))
    values.push(Payload(31 as UInt32))
    values

function make_packet() -> Packet
    Primary(make_values())

function consume_values(values: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function main() -> UInt32
    var packet: Packet = make_packet()
    switch packet
        Primary(values) =>
            var total: UInt32 = 0 as UInt32
            for item in true ? values : values
                total = total + item.value
            consume_values(values)
