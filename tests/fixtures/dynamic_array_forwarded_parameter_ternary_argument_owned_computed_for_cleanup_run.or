package fixtures.dynamicarrayforwardedparameterternaryargumentownedcomputedforcleanuprun

record Payload
    public value: UInt32

function forward_items(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    items

function forward_ternary_argument(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    forward_items(true ? items : items)

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(19 as UInt32))
    items.push(Payload(23 as UInt32))
    var total = 0 as UInt32
    for item in true ? forward_ternary_argument(items) : forward_ternary_argument(items)
        total = total + item.value
    total - 42 as UInt32
