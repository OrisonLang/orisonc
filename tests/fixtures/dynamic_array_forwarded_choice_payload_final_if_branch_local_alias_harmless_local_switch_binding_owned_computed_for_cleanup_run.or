package fixtures.dynamicarrayforwardedchoicepayloadfinalifbranchlocalaliasharmlesslocalswitchbindingownedcomputedforcleanuprun

record Payload
    public value: UInt32

choice Packet
    Primary(values: DynamicArray<Payload>)

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_packet(seed: UInt32) -> Packet
    Primary(make_values(seed))

function forward_packet(packet: Packet) -> Packet
    packet

function forward_packet_final_if_alias_harmless_local(flag: Bool, packet: Packet) -> Packet
    if flag
        let selected: Packet = packet
        selected
    else
        let selected: Packet = forward_packet(packet)
        var marker = 1 as Int64
        selected

function consume_packet(packet: Packet) -> UInt32
    var total = 0 as UInt32
    switch forward_packet_final_if_alias_harmless_local(false, packet)
        Primary(values) =>
            for item in true ? values : false ? values : values
                total = total + item.value
    total - 167 as UInt32

function main() -> UInt32
    consume_packet(make_packet(83 as UInt32))
