package fixtures.scalar_constants_run

type RegisterAddress = Address

const DEVICE_DATA: RegisterAddress = DEVICE_BASE + 0x04
const DEVICE_BASE: RegisterAddress = 0x4000_1000
const EXIT_CODE: UInt32 = ENABLED ? LOW_MASK bit_xor 255 : 1
const FALLBACK_CODE: UInt32 = DISABLED ? LOW_MASK : LOW_MASK - 248
const WIDE_LOW_MASK: UInt64 = LOW_MASK as UInt64
const WIDE_NEGATIVE: Int64 = NEGATIVE as Int64
const NEGATIVE: Int32 = (-1) as Int32
const LOW_MASK: UInt32 = 255
const ENABLED: Bool = MASK_MATCHES and ANY_MATCH
const DISABLED: Bool = MASK_MATCHES and (LOW_MASK != 255)
const ANY_MATCH: Bool = DISABLED or SCALE_MATCHES
const MASK_MATCHES: Bool = LOW_MASK == 255
const SCALE_MATCHES: Bool = SCALE >= 1.0
const SCALE: Float64 = 1.5

function device_data() -> RegisterAddress
    return DEVICE_DATA

function scale() -> Float64
    return SCALE

function wide_low_mask() -> UInt64
    return WIDE_LOW_MASK

function wide_negative() -> Int64
    return WIDE_NEGATIVE

function fallback_code() -> UInt32
    return FALLBACK_CODE

public function main() -> Int32
    if ENABLED
        return EXIT_CODE as Int32
    return 1
