package fixtures.dynamicarraylocalfinalswitchconsumedownercleanuprun

record Payload
    public value: Int64

function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function choose(flag: Bool) -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    switch flag
        true => use_items(items)
        false => 0 as UInt32

function main() -> UInt32
    choose(true)
