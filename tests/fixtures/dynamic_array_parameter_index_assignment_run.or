package tests.dynamicarrayparameterindexassignmentrun

function overwrite(items: DynamicArray<UInt32>) -> UInt32
    items[0] = 3 as UInt32
    items[0]

function main() -> UInt32
    var items: DynamicArray<UInt32> = DynamicArray()
    items.push(1 as UInt32)
    overwrite(items) == 3 ? 0 as UInt32 : 1 as UInt32
