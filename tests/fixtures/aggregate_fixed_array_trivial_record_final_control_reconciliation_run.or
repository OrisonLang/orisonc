package fixtures.aggregatefixedarraytrivialrecordfinalcontrolreconciliationrun

record Payload
    public value: UInt32

record Holder
    public items: Array<Payload, 2>

function consume_payload(payload: Payload) -> UInt32
    payload.value

function choose_if(flag: Bool) -> UInt32
    let holder: Holder = Holder([Payload(7 as UInt32), Payload(9 as UInt32)])
    if flag
        consume_payload(holder.items[0])
    else
        0 as UInt32

function choose_switch(flag: Bool) -> UInt32
    let holder: Holder = Holder([Payload(11 as UInt32), Payload(13 as UInt32)])
    switch flag
        true => consume_payload(holder.items[0])
        false => 0 as UInt32

function main() -> UInt32
    let if_consumed: UInt32 = choose_if(true)
    let if_finalized: UInt32 = choose_if(false)
    let switch_consumed: UInt32 = choose_switch(true)
    let switch_finalized: UInt32 = choose_switch(false)
    if_consumed - 7 as UInt32 + if_finalized + switch_consumed - 11 as UInt32 + switch_finalized
