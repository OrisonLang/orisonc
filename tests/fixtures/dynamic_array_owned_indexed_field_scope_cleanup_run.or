package tests.fixtures.dynamic_array_owned_indexed_field_scope_cleanup_run

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Item
    values: DynamicArray<Payload>

record Outer
    items: Array<Item, 2>

function make_left() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(1 as UInt32))
    values.push(Payload(2 as UInt32))
    values

function make_right() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(3 as UInt32))
    values.push(Payload(5 as UInt32))
    values

function main() -> UInt32
    var outer: Outer = Outer([Item(make_left()), Item(make_right())])
    0 as UInt32
