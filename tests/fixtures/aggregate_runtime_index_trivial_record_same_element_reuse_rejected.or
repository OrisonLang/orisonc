package fixtures.aggregateruntimeindextrivialrecordsameelementreuserejected

record Payload
    public value: UInt32

record Holder
    public items: Array<Payload, 2>

function consume_payload(payload: Payload) -> UInt32
    payload.value

function reuse(index: UInt64) -> UInt32
    let holder: Holder = Holder([Payload(7 as UInt32), Payload(9 as UInt32)])
    let first: UInt32 = consume_payload(holder.items[index])
    first + consume_payload(holder.items[index])
