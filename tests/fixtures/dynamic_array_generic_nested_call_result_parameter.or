package tests.dynamicarraygenericnestedcallresultparameter

function first<T>(values: DynamicArray<T>) -> T
    values[0]

function consume<T>(value: T) -> T
    value

function make_values() -> DynamicArray<UInt32>
    var values: DynamicArray<UInt32> = DynamicArray()
    values.push(7 as UInt32)
    values

function main() -> UInt32
    consume(first(make_values())) - 7 as UInt32
