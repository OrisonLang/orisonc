package fixtures.dynamicarray.completecontract

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

extend DynamicArray<T>
    function count(this: shared This) -> IntSize
        this.length()

    function first(this: shared This) -> T
        this[0]

    function count_each(this: shared This) -> IntSize
        var total: IntSize = 0 as IntSize
        for item in this
            total = total + 1 as IntSize
        total

    function append_value(this: exclusive This, value: T) -> Unit
        this.push(value)

    function replace_first(this: exclusive This, value: T) -> Unit
        this[0] = value

function scalar_demo() -> UInt32
    var values: DynamicArray<UInt32> = DynamicArray()
    values.append_value(3 as UInt32)
    values.push(5 as UInt32)
    values.replace_first(7 as UInt32)
    let count: IntSize = values.count()
    let counted: IntSize = values.count_each()
    let first: UInt32 = values.first()
    var total: UInt32 = 0 as UInt32
    for value in values
        total = total + value
    first + total

function owned_demo() -> UInt32
    var values: DynamicArray<Payload> = DynamicArray()
    values.append_value(Payload(11 as UInt32))
    values.push(Payload(13 as UInt32))
    values.replace_first(Payload(17 as UInt32))
    let count: IntSize = values.count_each()
    0 as UInt32

function main() -> UInt32
    0 as UInt32
