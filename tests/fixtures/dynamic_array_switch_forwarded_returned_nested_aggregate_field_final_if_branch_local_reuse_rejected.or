package fixtures.dynamicarrayswitchforwardedreturnednestedaggregatefieldfinalifbranchlocalreuserejected

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record PayloadBox
    public values: DynamicArray<Payload>

record OuterBox
    public inner: PayloadBox

function make_first_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(149 as UInt32))
    values.push(Payload(151 as UInt32))
    values

function make_second_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(157 as UInt32))
    values.push(Payload(163 as UInt32))
    values

function make_default_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(167 as UInt32))
    values.push(Payload(173 as UInt32))
    values

function make_scratch(seed: UInt32) -> DynamicArray<Payload>
    var scratch: DynamicArray<Payload> = DynamicArray()
    scratch.push(Payload(seed))
    scratch

function make_first_payload_box() -> PayloadBox
    PayloadBox(make_first_values())

function make_second_payload_box() -> PayloadBox
    PayloadBox(make_second_values())

function make_default_payload_box() -> PayloadBox
    PayloadBox(make_default_values())

function make_first_outer_box() -> OuterBox
    var inner: PayloadBox = make_first_payload_box()
    OuterBox(inner)

function make_second_outer_box() -> OuterBox
    var inner: PayloadBox = make_second_payload_box()
    OuterBox(inner)

function make_default_outer_box() -> OuterBox
    var inner: PayloadBox = make_default_payload_box()
    OuterBox(inner)

function forward_outer(box: OuterBox) -> OuterBox
    box

function consume_values(values: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function choose_outer(selector: UInt32) -> OuterBox
    switch selector
        0 as UInt32 => forward_outer(make_first_outer_box())
        1 as UInt32 => forward_outer(make_second_outer_box())
        default => forward_outer(make_default_outer_box())

function consume(flag: Bool) -> UInt32
    if flag
        var returned: OuterBox = choose_outer(1 as UInt32)
        var scratch: DynamicArray<Payload> = make_scratch(1 as UInt32)
        var total = 0 as UInt32
        for item in true ? returned.inner.values : false ? returned.inner.values : returned.inner.values
            total = total + item.value
        consume_values(scratch) + consume_values(scratch)
    else
        0 as UInt32

function main() -> UInt32
    consume(true)
