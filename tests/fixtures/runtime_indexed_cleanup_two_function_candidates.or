package tests.fixtures.runtime_indexed_cleanup_two_function_candidates

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Inner
    values: DynamicArray<Payload>
    spare: DynamicArray<Payload>

implements Drop for Inner
    function drop(this: exclusive This) -> Unit
        return

record Holder
    items: Array<Inner, 2>

implements Drop for Holder
    function drop(this: exclusive This) -> Unit
        return

choice TaggedInner
    Empty
    Primary(item: Inner)
    Secondary(item: Inner)

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_inner(seed: UInt32) -> Inner
    Inner(make_values(seed), make_values(seed + 10 as UInt32))

function select_first() -> UInt32
    var items: Array<Inner, 2> = [make_inner(1 as UInt32), make_inner(20 as UInt32)]
    var holder: Holder = Holder(items)
    let index: UInt64 = 0 as UInt64
    var selected: TaggedInner = Secondary(holder.items[index])
    0 as UInt32

function select_second() -> UInt32
    var items: Array<Inner, 2> = [make_inner(100 as UInt32), make_inner(200 as UInt32)]
    var holder: Holder = Holder(items)
    let index: UInt64 = 1 as UInt64
    var selected: TaggedInner = Primary(holder.items[index])
    0 as UInt32

function main() -> UInt32
    select_first() + select_second()
