package fixtures.dynamicarray.localownedreadrejected

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function main() -> UInt32
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(7 as UInt32))
    let first: Payload = values[0]
    first.value
