package fixtures.dynamicarrayownedresultfinalifbranchcleanuprun

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function choose(flag: Bool) -> DynamicArray<Payload>
    if flag
        var returned: DynamicArray<Payload> = make_values(7 as UInt32)
        var scratch: DynamicArray<Payload> = make_values(17 as UInt32)
        returned
    else
        var returned: DynamicArray<Payload> = make_values(11 as UInt32)
        var scratch: DynamicArray<Payload> = make_values(23 as UInt32)
        returned

function consume_items(items: DynamicArray<Payload>) -> UInt32
    items.length() == 2 ? 0 as UInt32 : 1 as UInt32

function main() -> UInt32
    var selected: DynamicArray<Payload> = choose(true)
    consume_items(selected)
