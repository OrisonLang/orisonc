package tests.fixtures.runtime_indexed_cleanup_choice_payload_source_drop

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Inner
    values: DynamicArray<Payload>

implements Drop for Inner
    function drop(this: exclusive This) -> Unit
        return

record Outer
    item: Inner

implements Drop for Outer
    function drop(this: exclusive This) -> Unit
        return

record Holder
    items: Array<Outer, 2>

implements Drop for Holder
    function drop(this: exclusive This) -> Unit
        return

choice SelectedOuter
    Empty
    Some(item: Outer)

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_inner(seed: UInt32) -> Inner
    Inner(make_values(seed))

function make_outer(seed: UInt32) -> Outer
    var inner: Inner = make_inner(seed)
    Outer(inner)

function select_outer(index: UInt64) -> UInt32
    var items: Array<Outer, 2> = [make_outer(1 as UInt32), make_outer(100 as UInt32)]
    var holder: Holder = Holder(items)
    var selected: SelectedOuter = Some(holder.items[index])
    0 as UInt32

function main() -> UInt32
    select_outer(1 as UInt64)
