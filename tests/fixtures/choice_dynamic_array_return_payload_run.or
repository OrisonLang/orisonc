package tests.fixtures.choice_dynamic_array_return_payload_run

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

choice DualBuffered
    Primary(values: DynamicArray<Payload>)
    Secondary(values: DynamicArray<Payload>)

function return_switch_payload(buffer: DualBuffered) -> DynamicArray<Payload>
    switch buffer
        Primary(values) => values
        Secondary(values) => values

function make_primary() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(7 as UInt32))
    values.push(Payload(11 as UInt32))
    return_switch_payload(Primary(values))

function make_secondary() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(13 as UInt32))
    values.push(Payload(17 as UInt32))
    values.push(Payload(19 as UInt32))
    return_switch_payload(Secondary(values))

function main() -> UInt32
    var returned: DynamicArray<Payload> = make_primary()
    let primary_count: IntSize = returned.length()
    returned = make_secondary()
    let secondary_count: IntSize = returned.length()
    primary_count == 2 and secondary_count == 3 ? 0 as UInt32 : 1 as UInt32
