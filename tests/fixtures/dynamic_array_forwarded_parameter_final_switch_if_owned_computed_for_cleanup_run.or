package fixtures.dynamicarrayforwardedparameterfinalswitchifownedcomputedforcleanuprun

record Payload
    value: Int64

function forward_items(items: DynamicArray<Payload>) -> DynamicArray<Payload>
    items

function forward_final_switch_if(selector: Bool, flag: Bool, items: DynamicArray<Payload>) -> DynamicArray<Payload>
    switch selector
        true =>
            items
        false =>
            if flag
                forward_items(items)
            else
                items

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    items.push(Payload(13))
    items.push(Payload(17))
    for item in true ? forward_final_switch_if(true, true, items) : forward_final_switch_if(false, false, items)
        total = total + item.value
    0 as UInt32
