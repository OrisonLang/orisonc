package fixtures.dynamicarrayownedparameterrepeatcontinuecleanupreuserejected

record Payload
    public value: Int64

function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function consume(items: DynamicArray<Payload>) -> IntSize
    var index = 0 as UInt64
    repeat
        use_items(items)
        index = index + 1 as UInt64
        if index == 1 as UInt64
            continue
    while index < 1 as UInt64
    items.length()

function main() -> IntSize
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    consume(items)
