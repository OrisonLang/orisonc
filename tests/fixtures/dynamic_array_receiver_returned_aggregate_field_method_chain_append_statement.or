package fixtures.dynamicarray.receiverreturnedaggregatefieldmethodchainappendstatement

record Nested
    value: UInt32

record Payload
    child: Nested

record PayloadBox
    values: DynamicArray<Payload>

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

extend DynamicArray<T>
    function forward(this: exclusive This) -> DynamicArray<T>
        this

    function append_value(this: exclusive This, value: T) -> Unit
        this.push(value)

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(7 as UInt32)))
    values

function make_box() -> PayloadBox
    PayloadBox(make_values())

function main() -> UInt32
    make_box().values.forward().append_value(Payload(Nested(11 as UInt32)))
    0 as UInt32
