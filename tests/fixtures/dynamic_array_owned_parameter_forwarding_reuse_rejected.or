package fixtures.dynamicarrayownedparameterforwardingreuse

record Payload
    public value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function use_items(items: DynamicArray<Payload>) -> UInt32
    0 as UInt32

function forward_items(items: DynamicArray<Payload>) -> IntSize
    let result: UInt32 = use_items(items)
    items.length()

function main() -> IntSize
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    forward_items(items)
