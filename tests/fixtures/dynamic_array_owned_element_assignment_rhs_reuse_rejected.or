package fixtures.dynamicarrayownedelementassignmentrhsreuse

record Payload
    public value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function main() -> Int64
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(7))
    let payload = Payload(8)
    items[0] = payload
    payload.value
