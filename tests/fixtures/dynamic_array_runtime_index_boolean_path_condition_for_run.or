package tests.fixtures.dynamic_array_runtime_index_boolean_path_condition_for_run

record Payload
    value: UInt32

record Bucket
    values: DynamicArray<Payload>

record Holder
    buckets: Array<Bucket, 2>

record IndexSettings
    flags: Array<Bool, 2>

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values

function make_holder(seed: UInt32) -> Holder
    Holder([Bucket(make_values(seed)), Bucket(make_values(seed + 20 as UInt32))])

function sum_selected(root_flag: Bool, condition_slot: UInt64, first: UInt64, second: UInt64) -> UInt32
    var left: Holder = make_holder(40 as UInt32)
    var right: Holder = make_holder(80 as UInt32)
    var settings = IndexSettings([true, false])
    var total = 0 as UInt32
    for item in root_flag ? left.buckets[settings.flags[condition_slot] ? first : second].values : right.buckets[settings.flags[condition_slot] ? first : second].values
        total = total + item.value
    total

function main() -> UInt32
    sum_selected(true, 0 as UInt64, 0 as UInt64, 1 as UInt64) + sum_selected(false, 1 as UInt64, 0 as UInt64, 1 as UInt64) - 140 as UInt32
