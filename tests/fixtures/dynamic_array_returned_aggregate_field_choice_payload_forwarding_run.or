package fixtures.dynamicarrayreturnedaggregatefieldchoicepayloadforwardingrun

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record PayloadBox
    public values: DynamicArray<Payload>

choice Packet
    Primary(values: DynamicArray<Payload>)

function make_values() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(7 as UInt32))
    values.push(Payload(11 as UInt32))
    values

function make_box() -> PayloadBox
    PayloadBox(make_values())

function unwrap_payload(packet: Packet) -> DynamicArray<Payload>
    switch packet
        Primary(values) => values

function consume_items(items: DynamicArray<Payload>) -> UInt32
    items.length() == 2 ? 0 as UInt32 : 1 as UInt32

function main() -> UInt32
    var returned: PayloadBox = make_box()
    var unwrapped: DynamicArray<Payload> = unwrap_payload(Primary(returned.values))
    consume_items(unwrapped)
