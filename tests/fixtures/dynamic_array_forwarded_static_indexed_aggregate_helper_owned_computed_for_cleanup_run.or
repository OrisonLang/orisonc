package fixtures.dynamicarrayforwardedstaticindexedaggregatehelperownedcomputedforcleanuprun

record Payload
    value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

record Bucket
    values: DynamicArray<Payload>

record Holder
    buckets: Array<Bucket, 2>

function make_values(seed: UInt32) -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(seed))
    values.push(Payload(seed + 1 as UInt32))
    values

function make_holder() -> Holder
    Holder([Bucket(make_values(40 as UInt32)), Bucket(make_values(80 as UInt32))])

function forward_holder(holder: Holder) -> Holder
    holder

function main() -> UInt32
    var holder: Holder = make_holder()
    var total = 0 as UInt32
    for item in true ? forward_holder(holder).buckets[0].values : forward_holder(holder).buckets[0 as UInt64].values
        total = total + item.value
    total - 81 as UInt32
