package fixtures.dynamicarray.receiverternaryownedmethods

record Nested
    value: UInt32

record Payload
    child: Nested

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

extend DynamicArray<T>
    function append_value(this: exclusive This, value: T) -> Unit
        this.push(value)

    function replace_first(this: exclusive This, value: T) -> Unit
        this[0] = value

function make_left() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(7 as UInt32)))
    values

function make_right() -> DynamicArray<Payload>
    var values: DynamicArray<Payload> = DynamicArray()
    values.push(Payload(Nested(11 as UInt32)))
    values

function main() -> UInt32
    let values = true ? make_left() : make_right()
    values.append_value(Payload(Nested(13 as UInt32)))
    values.replace_first(Payload(Nested(17 as UInt32)))
    values[0].child.value == 17 as UInt32 ? 0 as UInt32 : 1 as UInt32
