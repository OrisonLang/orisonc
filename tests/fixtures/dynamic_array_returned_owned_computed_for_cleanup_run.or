package fixtures.dynamicarrayreturnedownedcomputedforcleanuprun

record Payload
    public value: UInt32

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function make_items() -> DynamicArray<Payload>
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(13 as UInt32))
    items.push(Payload(17 as UInt32))
    items

function main() -> UInt32
    var returned: DynamicArray<Payload> = make_items()
    var total = 0 as UInt32
    for item in true ? returned : false ? returned : returned
        total = total + item.value
    total - 30 as UInt32
