package examples.concurrencyrecordchoicetask

record Pair
    public first: UInt32
    public second: UInt32

choice Result
    Failure(code: UInt32)
    Success(value: Pair)

implements Shareable for Result
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 19 as UInt32
    let second = 23 as UInt32
    let pending = task
        Success(Pair(first, second))

    let result: Result = await pending
    switch result
        Failure(code) => code + 1 as UInt32
        Success(value) => value.first + value.second == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
