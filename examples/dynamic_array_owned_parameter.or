package examples.dynamicarrayownedparameter

record Payload
    public value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function consume_items(items: DynamicArray<Payload>) -> Int64
    items.length() == 2 ? items[0].value + items[1].value : 0

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    items.push(Payload(5))
    items.push(Payload(7))
    consume_items(items) == 12 ? 0 as UInt32 : 1 as UInt32
