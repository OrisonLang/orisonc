package examples.concurrencyrecordchoicethread

record Pair
    public first: UInt32
    public second: UInt32

choice Result
    Failure(code: UInt32)
    Success(value: Pair)

implements Transferable for Result
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let first = 17 as UInt32
    let second = 25 as UInt32
    let worker = thread
        Success(Pair(first, second))

    let result: Result = worker.join()
    switch result
        Failure(code) => code + 1 as UInt32
        Success(value) => value.first + value.second == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
