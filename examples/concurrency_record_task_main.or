package examples.concurrencyrecordtask

record Pair
    public first: UInt32
    public second: UInt32

implements Shareable for Pair
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let pending = task
        Pair(19 as UInt32, 23 as UInt32)

    let result: Pair = await pending
    result.first + result.second == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
