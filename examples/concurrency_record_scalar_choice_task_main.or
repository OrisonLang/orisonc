package examples.concurrencyrecordscalarchoicetask

record Pair
    public first: UInt32
    public second: UInt32

choice Result
    Failure(code: UInt32)
    Success(value: Pair, marker: UInt32)

implements Shareable for Result
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 19 as UInt32
    let second = 20 as UInt32
    let marker = 3 as UInt32
    let pending = task
        Success(Pair(first, second), marker)

    let result: Result = await pending
    switch result
        Failure(code) => code + 1 as UInt32
        Success(value, received_marker) => value.first + value.second + received_marker == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
