package examples.concurrencynestedlocalcapturetask

async function main() -> UInt32
    let seed = 20 as UInt32
    let outer = task
        let local = seed + 1 as UInt32
        let inner = task
            local + local
        await inner

    let result: UInt32 = await outer
    result == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
