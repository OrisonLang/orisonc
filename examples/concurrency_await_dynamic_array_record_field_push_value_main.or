package examples.concurrency_await_dynamic_array_record_field_push_value

record Holder
    values: DynamicArray<UInt32>

async function main() -> UInt32
    var values: DynamicArray<UInt32> = DynamicArray()
    var holder: Holder = Holder(values)
    let pending = task
        47 as UInt32

    holder.values.push(await pending)
    holder.values[0] - 47 as UInt32
