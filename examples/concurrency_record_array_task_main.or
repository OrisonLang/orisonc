package examples.concurrencyrecordarraytask

record Pair
    public first: UInt32
    public second: UInt32

implements Shareable for Array<Pair, 2>
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 9 as UInt32
    let second = 10 as UInt32
    let third = 11 as UInt32
    let fourth = 12 as UInt32
    let pending = task
        [Pair(first, second), Pair(third, fourth)]

    let result: Array<Pair, 2> = await pending
    result[0].first + result[0].second + result[1].first + result[1].second == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
