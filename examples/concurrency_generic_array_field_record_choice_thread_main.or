package examples.concurrencygenericarrayfieldrecordchoicethread

record Batch
    public values: Array<UInt32, 2>
    public total: UInt32

choice Result<T>
    Failure(code: UInt32)
    Success(left: T, right: T)

implements Transferable for Result<Batch>
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let first = 2 as UInt32
    let second = 3 as UInt32
    let third = 4 as UInt32
    let fourth = 7 as UInt32
    let fifth = 11 as UInt32
    let sixth = 15 as UInt32
    let worker = thread
        Success(Batch([first, second], third), Batch([fourth, fifth], sixth))

    let result: Result<Batch> = worker.join()
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left.values[0] + left.values[1] + left.total + right.values[0] + right.values[1] + right.total == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
