package examples.concurrencygenericarraychoicethread

choice Result<T>
    Failure(code: UInt32)
    Success(left: T, right: T)

implements Transferable for Result<Array<UInt32, 2>>
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let first = 8 as UInt32
    let second = 10 as UInt32
    let third = 11 as UInt32
    let fourth = 13 as UInt32
    let worker = thread
        Success([first, second], [third, fourth])

    let result: Result<Array<UInt32, 2>> = worker.join()
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left[0] + left[1] + right[0] + right[1] == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
