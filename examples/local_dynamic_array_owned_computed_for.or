package examples.dynamicarrayownedcomputedfor

record Payload
    public value: Int64

interface Drop
    function drop(this: exclusive This) -> Unit

implements Drop for Payload
    function drop(this: exclusive This) -> Unit
        return

function main() -> UInt32
    var items: DynamicArray<Payload> = DynamicArray()
    var total = 0 as Int64
    items.push(Payload(5))
    items.push(Payload(7))
    for item in true ? items : items
        total = total + item.value
    0 as UInt32
