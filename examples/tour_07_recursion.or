package examples.recursion

public function factorial(value: Int64) -> Int64
    switch value
        0 => 1
        default => value * factorial(value - 1)

public function explicit_return(value: Int64) -> Int64
    if value < 0
        return 0

    value

public function tail_forward(value: Int64) -> Int64
    return tail explicit_return(value)

public function sum_to(value: Int64, acc: Int64) -> Int64
    guard value > 0 else
        return acc

    recur(value - 1, acc + value)
