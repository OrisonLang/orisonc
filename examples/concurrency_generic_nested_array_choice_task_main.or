package examples.concurrencygenericnestedarraychoicetask

choice Result<T>
    Failure(code: UInt32)
    Success(left: T, right: T)

implements Shareable for Result<Array<Array<UInt32, 2>, 2>>
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 1 as UInt32
    let second = 2 as UInt32
    let third = 3 as UInt32
    let fourth = 4 as UInt32
    let fifth = 5 as UInt32
    let sixth = 6 as UInt32
    let seventh = 9 as UInt32
    let eighth = 12 as UInt32
    let pending = task
        Success([[first, second], [third, fourth]], [[fifth, sixth], [seventh, eighth]])

    let result: Result<Array<Array<UInt32, 2>, 2>> = await pending
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left[0][0] + left[0][1] + left[1][0] + left[1][1] + right[0][0] + right[0][1] + right[1][0] + right[1][1] == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
