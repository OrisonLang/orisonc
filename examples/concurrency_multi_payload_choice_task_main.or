package examples.concurrencymultipayloadchoicetask

choice Result
    Failure(code: UInt32)
    Success(left: UInt32, right: UInt32)

implements Shareable for Result
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 19 as UInt32
    let second = 23 as UInt32
    let pending = task
        Success(first, second)

    let result: Result = await pending
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left + right == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
