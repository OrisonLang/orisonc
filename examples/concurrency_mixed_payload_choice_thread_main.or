package examples.concurrencymixedpayloadchoicethread

choice Result
    Failure(code: UInt32)
    Success(value: UInt32, accepted: Bool)

implements Transferable for Result
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let value = 42 as UInt32
    let accepted = true
    let worker = thread
        Success(value, accepted)

    let result: Result = worker.join()
    switch result
        Failure(code) => code + 1 as UInt32
        Success(received, allowed) => received == 42 as UInt32 and allowed ? 0 as UInt32 : 1 as UInt32
