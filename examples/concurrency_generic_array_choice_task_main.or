package examples.concurrencygenericarraychoicetask

choice Result<T>
    Failure(code: UInt32)
    Success(left: T, right: T)

implements Shareable for Result<Array<UInt32, 2>>
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 9 as UInt32
    let second = 10 as UInt32
    let third = 11 as UInt32
    let fourth = 12 as UInt32
    let pending = task
        Success([first, second], [third, fourth])

    let result: Result<Array<UInt32, 2>> = await pending
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left[0] + left[1] + right[0] + right[1] == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
