package examples.concurrencyarraythread

implements Transferable for Array<UInt32, 2>
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let first = 17 as UInt32
    let second = 25 as UInt32
    let worker = thread
        [first, second]

    let result: Array<UInt32, 2> = worker.join()
    result[0] + result[1] == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
