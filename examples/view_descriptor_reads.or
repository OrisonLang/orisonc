package examples.viewdescriptor

record ViewBucket
    marker: UInt32

record ViewWrapper
    bucket: ViewBucket

record ViewShelf
    buckets: Array<ViewBucket, 2>

extend UInt32
    public function forward_view(this: shared This, values: shared.View<UInt32>) -> shared.View<UInt32>
        values

extend ViewBucket
    public function forward_view(this: shared This, values: shared.View<UInt32>) -> shared.View<UInt32>
        values

function count(values: shared.View<UInt32>) -> IntSize
    values.length()

function first(values: exclusive.View<UInt32>) -> UInt32
    values[0]

function write_first(values: exclusive.View<UInt32>) -> Unit
    values[0] = 7 as UInt32

function forward(values: shared.View<UInt32>) -> shared.View<UInt32>
    values

function sum(values: shared.View<UInt32>) -> UInt32
    var total = 0 as UInt32
    for item in values
        total = total + item
    total

function sum_forwarded(values: shared.View<UInt32>) -> UInt32
    var total = 0 as UInt32
    for item in forward(values)
        total = total + item
    total

function sum_method_forwarded(seed: UInt32, values: shared.View<UInt32>) -> UInt32
    var total = 0 as UInt32
    for item in seed.forward_view(values)
        total = total + item
    total

function sum_member_forwarded(wrapper: ViewWrapper, values: shared.View<UInt32>) -> UInt32
    var total = 0 as UInt32
    for item in wrapper.bucket.forward_view(values)
        total = total + item
    total

function sum_index_member_forwarded(shelf: ViewShelf, values: shared.View<UInt32>) -> UInt32
    var total = 0 as UInt32
    for item in shelf.buckets[0].forward_view(values)
        total = total + item
    total

function main() -> UInt32
    0 as UInt32
