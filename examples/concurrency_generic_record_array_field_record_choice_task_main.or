package examples.concurrencygenericrecordarrayfieldrecordchoicetask

record Pair
    public first: UInt32
    public second: UInt32

record Batch
    public values: Array<Pair, 2>
    public marker: UInt32

choice Result<T>
    Failure(code: UInt32)
    Success(left: T, right: T)

implements Shareable for Result<Batch>
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 1 as UInt32
    let second = 2 as UInt32
    let third = 3 as UInt32
    let fourth = 4 as UInt32
    let fifth = 5 as UInt32
    let sixth = 6 as UInt32
    let seventh = 7 as UInt32
    let eighth = 8 as UInt32
    let ninth = 1 as UInt32
    let tenth = 5 as UInt32
    let pending = task
        Success(Batch([Pair(first, second), Pair(third, fourth)], fifth), Batch([Pair(sixth, seventh), Pair(eighth, ninth)], tenth))

    let result: Result<Batch> = await pending
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left.values[0].first + left.values[0].second + left.values[1].first + left.values[1].second + left.marker + right.values[0].first + right.values[0].second + right.values[1].first + right.values[1].second + right.marker == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
