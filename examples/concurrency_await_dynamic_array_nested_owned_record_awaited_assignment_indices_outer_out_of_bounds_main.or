package examples.concurrency_await_dynamic_array_nested_owned_record_awaited_assignment_indices_outer_out_of_bounds

record Payload
    values: DynamicArray<UInt32>

implements Shareable for Payload
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    var payloads: DynamicArray<Payload> = DynamicArray()
    let pending_payload = task
        var values: DynamicArray<UInt32> = DynamicArray()
        values.push(47 as UInt32)
        Payload(values)
    let pending_outer = task
        1 as UInt64
    let pending_inner = task
        0 as UInt64

    payloads.push(await pending_payload)
    payloads[await pending_outer].values[await pending_inner] = 53 as UInt32
    0 as UInt32
