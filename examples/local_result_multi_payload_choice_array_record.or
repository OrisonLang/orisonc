package examples.local_result_multi_payload_choice_array_record

choice Result<T>
    Ok(left: T, right: T)
    Error(code: UInt32)

record Holder
    result: Result<UInt32>

function score(result: Result<UInt32>) -> UInt32
    switch result
        Ok(left, right) => left + right
        Error(code) => code

function total(holders: Array<Holder, 2>) -> UInt32
    score(holders[0 as UInt64].result) + score(holders[1 as UInt64].result)

function choose(flag: Bool) -> Array<Holder, 2>
    flag ? [Holder(Ok(2 as UInt32, 5 as UInt32)), Holder(Error(1 as UInt32))] : [Holder(Error(1 as UInt32)), Holder(Ok(3 as UInt32, 4 as UInt32))]

function reassign(flag: Bool) -> UInt32
    var holders: Array<Holder, 2> = [Holder(Error(1 as UInt32)), Holder(Error(1 as UInt32))]
    if flag
        holders[0 as UInt64].result = Ok(3 as UInt32, 4 as UInt32)
    else
        holders[1 as UInt64].result = Ok(2 as UInt32, 5 as UInt32)

    total(holders)

function main() -> UInt32
    total(choose(true)) + total(choose(false)) + reassign(true) + reassign(false) - 32 as UInt32
