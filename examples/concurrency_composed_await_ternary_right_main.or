package examples.concurrency_composed_await_ternary_right

async function main() -> UInt32
    let base = 10 as UInt32
    let left_pending = task
        base + 3 as UInt32
    let right_pending = task
        base + 4 as UInt32
    let selected = false ? await left_pending : await right_pending

    selected - 14 as UInt32
