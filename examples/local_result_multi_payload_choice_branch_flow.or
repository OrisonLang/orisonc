package examples.local_result_multi_payload_choice_branch_flow

choice Result<T>
    Ok(left: T, right: T)
    Error(code: UInt32)

function make_ok() -> Result<UInt32>
    Ok(2 as UInt32, 5 as UInt32)

function choose(flag: Bool) -> Result<UInt32>
    flag ? make_ok() : Error(1 as UInt32)

function choose_from_switch(flag: Bool) -> Result<UInt32>
    switch flag
        true => Ok(3 as UInt32, 4 as UInt32)
        false => Error(1 as UInt32)

function score(result: Result<UInt32>) -> UInt32
    switch result
        Ok(left, right) => left + right
        Error(code) => code

function main() -> UInt32
    score(choose(true)) + score(choose(false)) + score(choose_from_switch(true)) + score(choose_from_switch(false)) - 16 as UInt32
