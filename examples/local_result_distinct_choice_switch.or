package demo.local_result_distinct_choice_switch

choice Result<T, E>
    Ok(value: T)
    Error(error: E)

function ok_score() -> UInt32
    let result: Result<UInt32, Bool> = Ok(7 as UInt32)
    switch result
        Ok(value) => value
        Error(error) => error ? 1 as UInt32 : 0 as UInt32

function error_score() -> UInt32
    let result: Result<UInt32, Bool> = Error(true)
    switch result
        Ok(value) => value
        Error(error) => error ? 1 as UInt32 : 0 as UInt32

function main() -> UInt32
    ok_score() + error_score() - 8 as UInt32
