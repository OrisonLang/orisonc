package examples.concurrencyarraytask

implements Shareable for Array<UInt32, 2>
    function placeholder(this: shared This) -> Unit
        return

async function main() -> UInt32
    let first = 19 as UInt32
    let second = 23 as UInt32
    let pending = task
        [first, second]

    let result: Array<UInt32, 2> = await pending
    result[0] + result[1] == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
