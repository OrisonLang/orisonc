package examples.concurrencygenericchoicethread

choice Result<T>
    Failure(code: UInt32)
    Success(left: T, right: T)

implements Transferable for Result<UInt32>
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let first = 17 as UInt32
    let second = 25 as UInt32
    let worker = thread
        Success(first, second)

    let result: Result<UInt32> = worker.join()
    switch result
        Failure(code) => code + 1 as UInt32
        Success(left, right) => left + right == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
