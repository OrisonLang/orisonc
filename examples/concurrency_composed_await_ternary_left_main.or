package examples.concurrency_composed_await_ternary_left

async function main() -> UInt32
    let base = 10 as UInt32
    let left_pending = task
        base + 3 as UInt32
    let right_pending = task
        base + 4 as UInt32
    let selected = true ? await left_pending : await right_pending

    selected - 13 as UInt32
