package examples.concurrencyrecordarraythread

record Pair
    public first: UInt32
    public second: UInt32

implements Transferable for Array<Pair, 2>
    function placeholder(this: shared This) -> Unit
        return

function main() -> UInt32
    let first = 6 as UInt32
    let second = 9 as UInt32
    let third = 12 as UInt32
    let fourth = 15 as UInt32
    let worker = thread
        [Pair(first, second), Pair(third, fourth)]

    let result: Array<Pair, 2> = worker.join()
    result[0].first + result[0].second + result[1].first + result[1].second == 42 as UInt32 ? 0 as UInt32 : 1 as UInt32
